{
  "name": "tabbied",
  "version": "0.9.0",
  "description": "Tabbied generative patterns: a framework-agnostic core, a <tabbied-pattern> web component, React and Vue components and a Svelte action, powered by css-doodle.",
  "type": "module",
  "license": "MIT",
  "author": "Sy Hong and Ye Joo Park",
  "homepage": "https://tabbied.com/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tabbied-design/tabbied.git",
    "directory": "packages/tabbied"
  },
  "keywords": [
    "css-doodle",
    "generative",
    "generative-art",
    "art",
    "pattern",
    "svg",
    "react",
    "svelte",
    "sveltekit",
    "vue",
    "nuxt",
    "web-component",
    "custom-element"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "import": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js",
      "default": "./dist/vue/index.js"
    },
    "./element": {
      "types": "./dist/element/index.d.ts",
      "import": "./dist/element/index.js",
      "default": "./dist/element/index.js"
    },
    "./element/react-jsx": {
      "types": "./dist/element/react-jsx.d.ts",
      "import": "./dist/element/react-jsx.js",
      "default": "./dist/element/react-jsx.js"
    },
    "./patterns": {
      "types": "./dist/patterns.generated.d.ts",
      "import": "./dist/patterns.generated.js",
      "default": "./dist/patterns.generated.js"
    },
    "./patterns/*": {
      "types": "./dist/patterns/*.d.ts",
      "import": "./dist/patterns/*.js",
      "default": "./dist/patterns/*.js"
    },
    "./snippets": {
      "types": "./dist/snippets/index.d.ts",
      "import": "./dist/snippets/index.js",
      "default": "./dist/snippets/index.js"
    },
    "./svg-export": {
      "types": "./dist/core/svgExport.d.ts",
      "import": "./dist/core/svgExport.js",
      "default": "./dist/core/svgExport.js"
    },
    "./catalog.json": "./catalog.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "bin": {
    "tabbied": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/patterns/*.map",
    "catalog.json",
    "llms.txt",
    "AGENTS.md"
  ],
  "sideEffects": [
    "./dist/**/register.js",
    "./dist/element/*.js"
  ],
  "scripts": {
    "codegen": "node scripts/codegen.mjs",
    "build": "node scripts/codegen.mjs && node scripts/generate-llms.mjs && node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node scripts/bundle-element.mjs",
    "test": "node --test",
    "dev": "node scripts/codegen.mjs && tsc -p tsconfig.json --watch",
    "typecheck": "node scripts/codegen.mjs && tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "css-doodle": "^0.51.0"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "vue": ">=3.3 <4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "esbuild": "0.28.1",
    "typescript": "^7.0.2",
    "vue": "^3.5.43"
  },
  "engines": {
    "node": ">=18"
  }
}
