)%, #000 $(d * 50)%); mask: radial-gradient(circle closest-side, transparent $(d * 50)%, #000 $(d * 50)%); -webkit-transition: ease 450ms; transition: ease 450ms; } :after { content: ''; position: absolute; inset: 7%; border-radius: 50%; background: @p(var(--color1)); -webkit-clip-path: polygon(50% 50%, $(round((50 + 75 * sin((r0 + (a1) * 0) * 0.0174533)) * 100) / 100)% $(round((50 - 75 * cos((r0 + (a1) * 0) * 0.0174533)) * 100) / 100)%, $(round((50 + 75 * sin((r0 + (a1) * 0.25) * 0.0174533)) * 100) / 100)% $(round((50 - 75 * cos((r0 + (a1) * 0.25) * 0.0174533)) * 100) / 100)%, $(round((50 + 75 * sin((r0 + (a1) * 0.5) * 0.0174533)) * 100) / 100)% $(round((50 - 75 * cos((r0 + (a1) * 0.5) * 0.0174533)) * 100) / 100)%, $(round((50 + 75 * sin((r0 + (a1) * 0.75) * 0.0174533)) * 100) / 100)% $(round((50 - 75 * cos((r0 + (a1) * 0.75) * 0.0174533)) * 100) / 100)%, $(round((50 + 75 * sin((r0 + (a1) * 1) * 0.0174533)) * 100) / 100)% $(round((50 - 75 * cos((r0 + (a1) * 1) * 0.0174533)) * 100) / 100)%); clip-path: polygon(50% 50%, $(round((50 + 75 * sin((r0 + (a1) * 0) * 0.0174533)) * 100) / 100)% $(round((50 - 75 * cos((r0 + (a1) * 0) * 0.0174533)) * 100) / 100)%, $(round((50 + 75 * sin((r0 + (a1) * 0.25) * 0.0174533)) * 100) / 100)% $(round((50 - 75 * cos((r0 + (a1) * 0.25) * 0.0174533)) * 100) / 100)%, $(round((50 + 75 * sin((r0 + (a1) * 0.5) * 0.0174533)) * 100) / 100)% $(round((50 - 75 * cos((r0 + (a1) * 0.5) * 0.0174533)) * 100) / 100)%, $(round((50 + 75 * sin((r0 + (a1) * 0.75) * 0.0174533)) * 100) / 100)% $(round((50 - 75 * cos((r0 + (a1) * 0.75) * 0.0174533)) * 100) / 100)%, $(round((50 + 75 * sin((r0 + (a1) * 1) * 0.0174533)) * 100) / 100)% $(round((50 - 75 * cos((r0 + (a1) * 1) * 0.0174533)) * 100) / 100)%); -webkit-mask: radial-gradient(circle closest-side, transparent $(d * 50)%, #000 $(d * 50)%); mask: radial-gradient(circle closest-side, transparent $(d * 50)%, #000 $(d * 50)%); -webkit-transition: ease 450ms; transition: ease 450ms; } } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box; } :container { background: var(--color0); overflow:hidden; }"
  }
}
