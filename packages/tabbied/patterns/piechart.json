{
  "name": "Pie Chart",
  "slug": "piechart",
  "galleryOrder": 4272,
  "description": "A sheet of pie and donut charts, each split into three slices in the same three inks at its own proportions and turned to its own angle.",
  "tags": [
    "circles",
    "radial",
    "rings"
  ],
  "mood": [
    "technical",
    "playful"
  ],
  "density": "medium",
  "goodFor": [
    "poster",
    "og-image",
    "packaging"
  ],
  "palette": [
    "#F4EFE4",
    "#E4572E",
    "#29335C",
    "#76B5A8"
  ],
  "colors": {
    "min": 2,
    "max": 4,
    "default": 4
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "6x9",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
