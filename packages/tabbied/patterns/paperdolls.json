{
  "name": "Paper Dolls",
  "slug": "paperdolls",
  "galleryOrder": 4283,
  "description": "Chains of paper dolls holding hands across the sheet, girls in flared skirts and boys in trousers, each row cut from one sheet of colored paper.",
  "tags": [
    "stripes",
    "grid",
    "curves"
  ],
  "mood": [
    "playful",
    "retro"
  ],
  "density": "medium",
  "goodFor": [
    "packaging",
    "section-divider",
    "wallpaper"
  ],
  "palette": [
    "#F1FAEE",
    "#E63946",
    "#A8DADC",
    "#457B9D",
    "#1D3557",
    "#F4A261"
  ],
  "colors": {
    "min": 2,
    "max": 6,
    "default": 6
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "6x9",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( --k0: @pd(@p(var(--color1), var(--color2))); --k1: @pd(@p(var(--color3), var(--color4))); --k2: @pd(@p(var(--color5))); @random(${shapeFrequency}) { --d: @match(y % 3 == 0, @var(--k0), y % 3 == 1, @var(--k1), @var(--k2)); :before { content: ''; position: absolute; inset: 4% 0 0 0; background: @p(@var(--d)); -webkit-clip-path: @p(@var(--girl), @var(--boy)); clip-path: @p(@var(--girl), @var(--boy)); -webkit-transition: ease 450ms; transition: ease 450ms; } } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box; --girl: polygon(50% 5%, 55.5% 6.47%, 59.53% 10.5%, 61% 16%, 59.53% 21.5%, 55.5% 25.53%, 53.5% 28%, 62% 31%, 100% 31%, 100% 39%, 66% 39%, 63% 44%, 79% 79%, 60% 79%, 60% 93%, 66% 95%, 66% 99%, 53% 99%, 53% 81%, 50% 81%, 47% 81%, 47% 99%, 34% 99%, 34% 95%, 40% 93%, 40% 79%, 21% 79%, 37% 44%, 34% 39%, 0% 39%, 0% 31%, 38% 31%, 46.5% 28%, 44.5% 25.53%, 40.47% 21.5%, 39% 16%, 40.47% 10.5%, 44.5% 6.47%); --boy: polygon(50% 5%, 55.5% 6.47%, 59.53% 10.5%, 61% 16%, 59.53% 21.5%, 55.5% 25.53%, 53.5% 28%, 62% 31%, 100% 31%, 100% 39%, 66% 39%, 64% 46%, 64% 64%, 63% 64%, 62% 93%, 66% 95%, 66% 99%, 53% 99%, 52% 66%, 50% 66%, 48% 66%, 47% 99%, 34% 99%, 34% 95%, 38% 93%, 37% 64%, 36% 64%, 36% 46%, 34% 39%, 0% 39%, 0% 31%, 38% 31%, 46.5% 28%, 44.5% 25.53%, 40.47% 21.5%, 39% 16%, 40.47% 10.5%, 44.5% 6.47%); } :container { background: var(--color0); overflow:hidden; }"
  }
}
