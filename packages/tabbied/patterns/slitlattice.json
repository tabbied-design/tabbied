{
  "name": "Slit Lattice",
  "slug": "slitlattice",
  "galleryOrder": 4041,
  "description": "A sheet of paper cut with staggered rows of slits and pulled open, the slits gaping into diamonds that are widest round one point and close up to thin slits away from it.",
  "tags": [
    "diamonds",
    "lattice",
    "grid"
  ],
  "mood": [
    "technical",
    "bold"
  ],
  "density": "dense",
  "goodFor": [
    "hero-background",
    "poster",
    "wallpaper"
  ],
  "palette": [
    "#FFF1E6",
    "#FF006E",
    "#3A86FF",
    "#FFBE0B",
    "#8338EC",
    "#FB5607"
  ],
  "colors": {
    "min": 2,
    "max": 6,
    "default": 6
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "8x12",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( --k: @pd(@p(var(--color1), var(--color2), var(--color3), var(--color4), var(--color5))); --cx: @pd(@p(0.3, 0.38, 0.46, 0.54, 0.62, 0.7)); --cy: @pd(@p(0.3, 0.38, 0.46, 0.54, 0.62, 0.7)); @random(${shapeFrequency}) { --t: @calc(1.5 + 30 * pow(max(0, cos(min(1.5708, 1.5708 * sqrt(pow((@x - 0.5) - $(cx) * @X, 2) + pow((@y - 1) - $(cy) * @Y, 2)) / (0.6 * max(@X, @Y))))), 2)); --b: @calc(1.5 + 30 * pow(max(0, cos(min(1.5708, 1.5708 * sqrt(pow((@x - 0.5) - $(cx) * @X, 2) + pow((@y) - $(cy) * @Y, 2)) / (0.6 * max(@X, @Y))))), 2)); --l: @calc(1.5 + 30 * pow(max(0, cos(min(1.5708, 1.5708 * sqrt(pow((@x - 1) - $(cx) * @X, 2) + pow((@y - 0.5) - $(cy) * @Y, 2)) / (0.6 * max(@X, @Y))))), 2)); --r: @calc(1.5 + 30 * pow(max(0, cos(min(1.5708, 1.5708 * sqrt(pow((@x) - $(cx) * @X, 2) + pow((@y - 0.5) - $(cy) * @Y, 2)) / (0.6 * max(@X, @Y))))), 2)); background: @p(@var(--k)); -webkit-transform: scale(1.012); transform: scale(1.012); -webkit-clip-path: polygon(0% 0%, 12% 0%, 50% $(t)%, 88% 0%, 100% 0%, 100% $(50 - r)%, 62% 50%, 100% $(50 + r)%, 100% 100%, 88% 100%, 50% $(100 - b)%, 12% 100%, 0% 100%, 0% $(50 + l)%, 38% 50%, 0% $(50 - l)%); clip-path: polygon(0% 0%, 12% 0%, 50% $(t)%, 88% 0%, 100% 0%, 100% $(50 - r)%, 62% 50%, 100% $(50 + r)%, 100% 100%, 88% 100%, 50% $(100 - b)%, 12% 100%, 0% 100%, 0% $(50 + l)%, 38% 50%, 0% $(50 - l)%); } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box; } :container { background: var(--color0); overflow:hidden; }"
  }
}
