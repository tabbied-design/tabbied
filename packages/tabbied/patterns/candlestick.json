{
  "name": "Candlestick",
  "slug": "candlestick",
  "galleryOrder": 4274,
  "galleryWhite": true,
  "description": "Rows of candlestick charts on a dark screen: teal and red bodies with thin wicks above and below, drifting up and down with a smooth trend.",
  "tags": [
    "blocks",
    "lines",
    "stripes"
  ],
  "mood": [
    "technical",
    "bold"
  ],
  "density": "medium",
  "goodFor": [
    "hero-background",
    "poster",
    "og-image"
  ],
  "palette": [
    "#0E1621",
    "#2BC4A0",
    "#F2545B",
    "#26384A"
  ],
  "colors": {
    "min": 2,
    "max": 4,
    "default": 4
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "6x9",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( @random(${shapeFrequency}) { --m: @rn(-30, 130, 1.6); --c1: $(round(max(34, min(66, m))) + @ri(-9, 9)); --h1: @ri(6, 17); --u1: @ri(4, 13); --d1: @ri(4, 13); --c2: $(round(max(34, min(66, m))) + @ri(-9, 9)); --h2: @ri(6, 17); --u2: @ri(4, 13); --d2: @ri(4, 13); background: repeating-linear-gradient(180deg, transparent 0 24%, var(--color3) 24% 25%); :before { content: ''; position: absolute; left: 8%; width: 38%; top: 0; bottom: 0; background: @p(var(--color1), var(--color2)); -webkit-clip-path: polygon(46% $(c1 - h1 - u1)%, 54% $(c1 - h1 - u1)%, 54% $(c1 - h1)%, 84% $(c1 - h1)%, 84% $(c1 + h1)%, 54% $(c1 + h1)%, 54% $(c1 + h1 + d1)%, 46% $(c1 + h1 + d1)%, 46% $(c1 + h1)%, 16% $(c1 + h1)%, 16% $(c1 - h1)%, 46% $(c1 - h1)%); clip-path: polygon(46% $(c1 - h1 - u1)%, 54% $(c1 - h1 - u1)%, 54% $(c1 - h1)%, 84% $(c1 - h1)%, 84% $(c1 + h1)%, 54% $(c1 + h1)%, 54% $(c1 + h1 + d1)%, 46% $(c1 + h1 + d1)%, 46% $(c1 + h1)%, 16% $(c1 + h1)%, 16% $(c1 - h1)%, 46% $(c1 - h1)%); -webkit-transition: ease 450ms; transition: ease 450ms; } :after { content: ''; position: absolute; left: 54%; width: 38%; top: 0; bottom: 0; background: @p(var(--color1), var(--color2)); -webkit-clip-path: polygon(46% $(c2 - h2 - u2)%, 54% $(c2 - h2 - u2)%, 54% $(c2 - h2)%, 84% $(c2 - h2)%, 84% $(c2 + h2)%, 54% $(c2 + h2)%, 54% $(c2 + h2 + d2)%, 46% $(c2 + h2 + d2)%, 46% $(c2 + h2)%, 16% $(c2 + h2)%, 16% $(c2 - h2)%, 46% $(c2 - h2)%); clip-path: polygon(46% $(c2 - h2 - u2)%, 54% $(c2 - h2 - u2)%, 54% $(c2 - h2)%, 84% $(c2 - h2)%, 84% $(c2 + h2)%, 54% $(c2 + h2)%, 54% $(c2 + h2 + d2)%, 46% $(c2 + h2 + d2)%, 46% $(c2 + h2)%, 16% $(c2 + h2)%, 16% $(c2 - h2)%, 46% $(c2 - h2)%); -webkit-transition: ease 450ms; transition: ease 450ms; } } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box; } :container { background: var(--color0); overflow:hidden; }"
  }
}
