{
  "name": "Rubber Sheet",
  "slug": "rubbersheet",
  "galleryOrder": 4089,
  "description": "A grid of plus marks pushed out of line by a smooth displacement, bunching, shrinking, spreading and twisting as if printed on stretched rubber.",
  "tags": [
    "crosses",
    "grid"
  ],
  "mood": [
    "playful",
    "technical"
  ],
  "density": "medium",
  "goodFor": [
    "wallpaper",
    "card-texture"
  ],
  "palette": [
    "#FFE8D6",
    "#FF6F59",
    "#254441",
    "#43AA8B",
    "#B2B09B",
    "#EF3054"
  ],
  "colors": {
    "min": 2,
    "max": 6,
    "default": 6
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "8x12",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( @random(${shapeFrequency}) { background: @p(var(--color1), var(--color2), var(--color3), var(--color4), var(--color5)); -webkit-clip-path: polygon(42% 16%, 58% 16%, 58% 42%, 84% 42%, 84% 58%, 58% 58%, 58% 84%, 42% 84%, 42% 58%, 16% 58%, 16% 42%, 42% 42%); clip-path: polygon(42% 16%, 58% 16%, 58% 42%, 84% 42%, 84% 58%, 58% 58%, 58% 84%, 42% 84%, 42% 58%, 16% 58%, 16% 42%, 42% 42%); -webkit-transform: translate(@rn(-70, 70, 2.2)%, @rn(-70, 70, 2.2)%) rotate(@rn(-50, 50, 1.4)deg) scale(@calc(max(0.45, min(1.3, @rn(0, 1.6, 1.3))))); transform: translate(@rn(-70, 70, 2.2)%, @rn(-70, 70, 2.2)%) rotate(@rn(-50, 50, 1.4)deg) scale(@calc(max(0.45, min(1.3, @rn(0, 1.6, 1.3))))); } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box; } :container { background: var(--color0); overflow:hidden; }"
  }
}
