{
  "name": "Knight Tour",
  "slug": "knighttour",
  "galleryOrder": 4249,
  "description": "A knight's tour: every square of a chessboard joined to the next by a knight's move, a dot on each light square and a block on each dark one, the strokes crossing into a web in four colors.",
  "tags": [
    "lines",
    "dots",
    "diagonals",
    "grid"
  ],
  "mood": [
    "technical",
    "elegant"
  ],
  "density": "medium",
  "goodFor": [
    "poster",
    "card-texture"
  ],
  "palette": [
    "#F1EADB",
    "#2B4C7E",
    "#1E8A6E",
    "#E08E2B",
    "#C0392B"
  ],
  "colors": {
    "min": 2,
    "max": 5,
    "default": 5
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "8x12",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( --gate: @r(1); --ox: @pd(@ri(0, 7)); --oy: @pd(@ri(0, 7)); --co: @pd(@ri(0, 63)); --kq: @calc(0 + (@x - 1 + $(ox)) % 8 + 8 * ((@y - 1 + $(oy)) % 8)); --kv: @match($(kq) == 0, 9, $(kq) == 1, 33, $(kq) == 2, 511, $(kq) == 3, 230, $(kq) == 4, 137, $(kq) == 5, 49, $(kq) == 6, 446, $(kq) == 7, 422, $(kq) == 8, 498, $(kq) == 9, 239, $(kq) == 10, 22, $(kq) == 11, 42, $(kq) == 12, 454, $(kq) == 13, 425, $(kq) == 14, 144, $(kq) == 15, 63, $(kq) == 16, 27, $(kq) == 17, 4, $(kq) == 18, 456, $(kq) == 19, 486, $(kq) == 20, 220, $(kq) == 21, 132, $(kq) == 22, 411, $(kq) == 23, 436, $(kq) == 24, 240, $(kq) == 25, 492, $(kq) == 26, 210, $(kq) == 27, 122, $(kq) == 28, 384, $(kq) == 29, 477, $(kq) == 30, 64, $(kq) == 31, 158, $(kq) == 32, 202, $(kq) == 33, 114, $(kq) == 34, 378, $(kq) == 35, 466, $(kq) == 36, 335, $(kq) == 37, 160, $(kq) == 38, 366, $(kq) == 39, 404, $(kq) == 40, 272, $(kq) == 41, 255, $(kq) == 42, 288, $(kq) == 43, 190, $(kq) == 44, 373, $(kq) == 45, 394, $(kq) == 46, 325, $(kq) == 47, 79, $(kq) == 48, 107, $(kq) == 49, 196, $(kq) == 50, 269, $(kq) == 51, 337, $(kq) == 52, 94, $(kq) == 53, 305, $(kq) == 54, 174, $(kq) == 55, 356, $(kq) == 56, 258, $(kq) == 57, 283, $(kq) == 58, 101, $(kq) == 59, 298, $(kq) == 60, 180, $(kq) == 61, 346, $(kq) == 62, 85, 316); --ks: @calc(floor($(kv) / 8)); --kd: @calc(0 + $(kv) % 8); @random(${shapeFrequency}) { :before { content: ''; position: absolute; left: 50%; top: 46.5%; width: 223.61%; height: 7%; border-radius: 99px; background: @match(floor((($(ks) + $(co)) % 64) / 16) == 0, @p(var(--color1)), floor((($(ks) + $(co)) % 64) / 16) == 1, @p(var(--color2)), floor((($(ks) + $(co)) % 64) / 16) == 2, @p(var(--color3)), @p(var(--color4))); -webkit-transform-origin: 0 50%; transform-origin: 0 50%; -webkit-transform: rotate(@match($(kd) == 0, 63.43deg, $(kd) == 1, 26.57deg, $(kd) == 2, -26.57deg, $(kd) == 3, -63.43deg, $(kd) == 4, -116.57deg, $(kd) == 5, -153.43deg, $(kd) == 6, 153.43deg, 116.57deg)); transform: rotate(@match($(kd) == 0, 63.43deg, $(kd) == 1, 26.57deg, $(kd) == 2, -26.57deg, $(kd) == 3, -63.43deg, $(kd) == 4, -116.57deg, $(kd) == 5, -153.43deg, $(kd) == 6, 153.43deg, 116.57deg)); -webkit-transition: ease 450ms; transition: ease 450ms; } :after { content: ''; position: absolute; --dk: @calc(0 + (@x + @y + $(ox) + $(oy)) % 2); left: @match($(dk) == 1, 33%, 38%); top: @match($(dk) == 1, 33%, 38%); width: @match($(dk) == 1, 34%, 24%); height: @match($(dk) == 1, 34%, 24%); border-radius: @match($(dk) == 1, 24%, 50%); background: @match(floor((($(ks) + $(co)) % 64) / 16) == 0, @p(var(--color1)), floor((($(ks) + $(co)) % 64) / 16) == 1, @p(var(--color2)), floor((($(ks) + $(co)) % 64) / 16) == 2, @p(var(--color3)), @p(var(--color4))); -webkit-transition: ease 450ms; transition: ease 450ms; } } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box; } :container { background: var(--color0); overflow:hidden; }"
  }
}
