{
  "name": "Low Poly",
  "slug": "lowpoly",
  "galleryOrder": 4240,
  "galleryWhite": true,
  "description": "A low poly mesh of irregular triangles, every grid point nudged off true and the facets shaded through smooth bands of color like a faceted landscape.",
  "tags": [
    "triangles",
    "mosaic",
    "gradients"
  ],
  "mood": [
    "calm",
    "technical"
  ],
  "density": "dense",
  "goodFor": [
    "hero-background",
    "og-image"
  ],
  "palette": [
    "#0E1A2B",
    "#1B3A5C",
    "#2D6A8A",
    "#4FA3A5",
    "#A8D5BA",
    "#F2E8C9"
  ],
  "colors": {
    "min": 2,
    "max": 6,
    "default": 6
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "8x12",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( --gate: @r(1); --s: @pd(@r(0, 50)); --ix: @x; --iy: @y; --mx: @X; --my: @Y; --pa: $(round(1100 + 2800*(abs(sin(ix*12.99 + iy*78.23 + s - 91.22))*43758.5 % 1))/100)% $(round(1100 + 2800*(abs(sin(ix*39.35 + iy*11.14 + s*1.3 - 50.49))*43758.5 % 1))/100)%; --pb: $(round(6100 + 2800*(abs(sin(ix*12.99 + iy*78.23 + s - 78.23))*43758.5 % 1))/100)% $(round(1100 + 2800*(abs(sin(ix*39.35 + iy*11.14 + s*1.3 - 11.14))*43758.5 % 1))/100)%; --pc: $(round(6100 + 2800*(abs(sin(ix*12.99 + iy*78.23 + s))*43758.5 % 1))/100)% $(round(6100 + 2800*(abs(sin(ix*39.35 + iy*11.14 + s*1.3))*43758.5 % 1))/100)%; --pd: $(round(1100 + 2800*(abs(sin(ix*12.99 + iy*78.23 + s - 12.99))*43758.5 % 1))/100)% $(round(6100 + 2800*(abs(sin(ix*39.35 + iy*11.14 + s*1.3 - 39.35))*43758.5 % 1))/100)%; @x(1) { --pa: 25% $(round(1100 + 2800*(abs(sin(ix*39.35 + iy*11.14 + s*1.3 - 50.49))*43758.5 % 1))/100)%; --pd: 25% $(round(6100 + 2800*(abs(sin(ix*39.35 + iy*11.14 + s*1.3 - 39.35))*43758.5 % 1))/100)%; } @match(x == X) { --pb: 75% $(round(1100 + 2800*(abs(sin(ix*39.35 + iy*11.14 + s*1.3 - 11.14))*43758.5 % 1))/100)%; --pc: 75% $(round(6100 + 2800*(abs(sin(ix*39.35 + iy*11.14 + s*1.3))*43758.5 % 1))/100)%; } @y(1) { --pa: $(round(1100 + 2800*(abs(sin(ix*12.99 + iy*78.23 + s - 91.22))*43758.5 % 1))/100)% 25%; --pb: $(round(6100 + 2800*(abs(sin(ix*12.99 + iy*78.23 + s - 78.23))*43758.5 % 1))/100)% 25%; } @match(y == Y) { --pc: $(round(6100 + 2800*(abs(sin(ix*12.99 + iy*78.23 + s))*43758.5 % 1))/100)% 75%; --pd: $(round(1100 + 2800*(abs(sin(ix*12.99 + iy*78.23 + s - 12.99))*43758.5 % 1))/100)% 75%; } @match(x == 1 && y == 1) { --pa: 25% 25%; } @match(x == X && y == 1) { --pb: 75% 25%; } @match(x == X && y == Y) { --pc: 75% 75%; } @match(x == 1 && y == Y) { --pd: 25% 75%; } --quad: polygon(@var(--pa), @var(--pb), @var(--pc), @var(--pd)); --tri: polygon(@var(--pa), @var(--pb), @p(@var(--pc), @var(--pd))); --n: @rn(-0.6, 1.6, 1.1); @random(${shapeFrequency}) { :before { content: ''; position: absolute; left: -50%; top: -50%; width: 200%; height: 200%; background: @p(@var(--color$(1 + min(4, max(0, floor((n + @p(-0.12, -0.06, 0, 0.06, 0.12)) * 5)))))); -webkit-clip-path: @var(--quad); clip-path: @var(--quad); -webkit-transition: ease 450ms; transition: ease 450ms; } :after { content: ''; position: absolute; left: -50%; top: -50%; width: 200%; height: 200%; background: @p(@var(--color$(1 + min(4, max(0, floor((n + @p(-0.12, -0.06, 0, 0.06, 0.12)) * 5)))))); -webkit-clip-path: @var(--tri); clip-path: @var(--tri); -webkit-transition: ease 450ms; transition: ease 450ms; } } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box; } :container { background: var(--color0); overflow:hidden; }"
  }
}
