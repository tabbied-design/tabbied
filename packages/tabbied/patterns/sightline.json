{
  "name": "Sightline",
  "slug": "sightline",
  "galleryOrder": 4070,
  "description": "Nested squares whose inner frames slide off-center, each cell looking down a tube that swings round as it crosses the sheet.",
  "tags": [
    "squares",
    "concentric",
    "blocks"
  ],
  "mood": [
    "retro",
    "bold"
  ],
  "density": "dense",
  "goodFor": [
    "poster",
    "packaging"
  ],
  "palette": [
    "#F1ECE2",
    "#E8B04B",
    "#E09A6B",
    "#B5533C",
    "#3B2A3F"
  ],
  "colors": {
    "min": 2,
    "max": 5,
    "default": 5
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "6x9",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( @random(${shapeFrequency}) { background: @p(var(--color1), var(--color2)); -webkit-clip-path: inset(5%); clip-path: inset(5%); :before { content: ''; position: absolute; inset: 0; background: var(--color3); -webkit-clip-path: inset(@calc(round(((50 + 15 * sin((2 * PI * (0.8 * (@x - 0.5) / @X + 0.55 * (@y - 0.5) / @Y)))) - 29) * 100) / 100)% @calc(round((100 - (50 + 15 * cos((2 * PI * (0.8 * (@x - 0.5) / @X + 0.55 * (@y - 0.5) / @Y)))) - 29) * 100) / 100)% @calc(round((100 - (50 + 15 * sin((2 * PI * (0.8 * (@x - 0.5) / @X + 0.55 * (@y - 0.5) / @Y)))) - 29) * 100) / 100)% @calc(round(((50 + 15 * cos((2 * PI * (0.8 * (@x - 0.5) / @X + 0.55 * (@y - 0.5) / @Y)))) - 29) * 100) / 100)%); clip-path: inset(@calc(round(((50 + 15 * sin((2 * PI * (0.8 * (@x - 0.5) / @X + 0.55 * (@y - 0.5) / @Y)))) - 29) * 100) / 100)% @calc(round((100 - (50 + 15 * cos((2 * PI * (0.8 * (@x - 0.5) / @X + 0.55 * (@y - 0.5) / @Y)))) - 29) * 100) / 100)% @calc(round((100 - (50 + 15 * sin((2 * PI * (0.8 * (@x - 0.5) / @X + 0.55 * (@y - 0.5) / @Y)))) - 29) * 100) / 100)% @calc(round(((50 + 15 * cos((2 * PI * (0.8 * (@x - 0.5) / @X + 0.55 * (@y - 0.5) / @Y)))) - 29) * 100) / 100)%); -webkit-transition: ease 450ms; transition: ease 450ms; } :after { content: ''; position: absolute; inset: 0; background: var(--color4); -webkit-clip-path: inset(@calc(round(((50 + 29 * sin((2 * PI * (0.8 * (@x - 0.5) / @X + 0.55 * (@y - 0.5) / @Y)))) - 13) * 100) / 100)% @calc(round((100 - (50 + 29 * cos((2 * PI * (0.8 * (@x - 0.5) / @X + 0.55 * (@y - 0.5) / @Y)))) - 13) * 100) / 100)% @calc(round((100 - (50 + 29 * sin((2 * PI * (0.8 * (@x - 0.5) / @X + 0.55 * (@y - 0.5) / @Y)))) - 13) * 100) / 100)% @calc(round(((50 + 29 * cos((2 * PI * (0.8 * (@x - 0.5) / @X + 0.55 * (@y - 0.5) / @Y)))) - 13) * 100) / 100)%); clip-path: inset(@calc(round(((50 + 29 * sin((2 * PI * (0.8 * (@x - 0.5) / @X + 0.55 * (@y - 0.5) / @Y)))) - 13) * 100) / 100)% @calc(round((100 - (50 + 29 * cos((2 * PI * (0.8 * (@x - 0.5) / @X + 0.55 * (@y - 0.5) / @Y)))) - 13) * 100) / 100)% @calc(round((100 - (50 + 29 * sin((2 * PI * (0.8 * (@x - 0.5) / @X + 0.55 * (@y - 0.5) / @Y)))) - 13) * 100) / 100)% @calc(round(((50 + 29 * cos((2 * PI * (0.8 * (@x - 0.5) / @X + 0.55 * (@y - 0.5) / @Y)))) - 13) * 100) / 100)%); -webkit-transition: ease 450ms; transition: ease 450ms; } } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box; } :container { background: var(--color0); overflow:hidden; }"
  }
}
