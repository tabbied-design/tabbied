{
  "name": "Pixel Maze",
  "slug": "pixelmaze",
  "galleryOrder": 4230,
  "galleryWhite": true,
  "description": "The ten print maze in chunky pixels: stepped diagonal strokes, one per cell, leaning either way and joining at the corners into a blocky labyrinth.",
  "tags": [
    "maze",
    "steps",
    "diagonals"
  ],
  "mood": [
    "retro",
    "technical"
  ],
  "density": "medium",
  "goodFor": [
    "wallpaper",
    "card-texture"
  ],
  "palette": [
    "#2E2A6B",
    "#8C82E6",
    "#B9B2F5"
  ],
  "colors": {
    "min": 2,
    "max": 3,
    "default": 3
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "8x12",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( --gate: @r(1); @random(${shapeFrequency}) { -webkit-transform: rotate(@p(0deg, 90deg)); transform: rotate(@p(0deg, 90deg)); background: @p(var(--color1), var(--color1), var(--color2)); -webkit-clip-path: @var(--px); clip-path: @var(--px); } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box; --px: polygon(0% 100%, 0% 83.33%, 16.67% 83.33%, 16.67% 66.67%, 33.33% 66.67%, 33.33% 50%, 50% 50%, 50% 33.33%, 66.67% 33.33%, 66.67% 16.67%, 83.33% 16.67%, 83.33% 0%, 100% 0%, 100% 16.67%, 100% 16.67%, 100% 33.33%, 83.33% 33.33%, 83.33% 50%, 66.67% 50%, 66.67% 66.67%, 50% 66.67%, 50% 83.33%, 33.33% 83.33%, 33.33% 100%); } :container { background: var(--color0); overflow:hidden; }"
  }
}
