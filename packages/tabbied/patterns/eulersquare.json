{
  "name": "Euler Square",
  "slug": "eulersquare",
  "galleryOrder": 4248,
  "description": "Circles, squares, triangles, diamonds and crosses in five inks, arranged as a Graeco-Latin square so every shape meets every color once in each five by five block.",
  "tags": [
    "circles",
    "squares",
    "triangles",
    "diamonds",
    "crosses",
    "grid"
  ],
  "mood": [
    "playful",
    "technical"
  ],
  "density": "medium",
  "goodFor": [
    "poster",
    "packaging"
  ],
  "palette": [
    "#FBF6EC",
    "#2A2A2A",
    "#D1495B",
    "#EDAE49",
    "#00798C",
    "#30638E"
  ],
  "colors": {
    "min": 2,
    "max": 6,
    "default": 6
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "5x5",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( --gate: @r(1); --a: @pd(@ri(0, 4)); --b: @pd(@ri(0, 4)); --sh: @calc(0 + (@x + @y + $(a)) % 5); --ik: @calc(0 + (@x + 2 * @y + $(b)) % 5); @random(${shapeFrequency}) { background: @match($(ik) == 0, @p(var(--color1)), $(ik) == 1, @p(var(--color2)), $(ik) == 2, @p(var(--color3)), $(ik) == 3, @p(var(--color4)), @p(var(--color5))); -webkit-clip-path: @match($(sh) == 0, @var(--e0), $(sh) == 1, @var(--e1), $(sh) == 2, @var(--e2), $(sh) == 3, @var(--e3), @var(--e4)); clip-path: @match($(sh) == 0, @var(--e0), $(sh) == 1, @var(--e1), $(sh) == 2, @var(--e2), $(sh) == 3, @var(--e3), @var(--e4)); } -webkit-transition: ease 450ms; transition: ease 450ms; );",
