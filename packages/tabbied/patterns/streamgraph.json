{
  "name": "Streamgraph",
  "slug": "streamgraph",
  "galleryOrder": 4273,
  "description": "Rows of streamgraphs: three colored layers stacked about a midline, swelling and thinning in smooth waves as they flow across the sheet.",
  "tags": [
    "waves",
    "curves",
    "stripes"
  ],
  "mood": [
    "calm",
    "organic"
  ],
  "density": "medium",
  "goodFor": [
    "hero-background",
    "section-divider"
  ],
  "palette": [
    "#FFFAF0",
    "#E76F51",
    "#2A9D8F",
    "#264653"
  ],
  "colors": {
    "min": 2,
    "max": 4,
    "default": 4
  },
  "sizing": {
    "minCellPx": 54
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "6x9",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( --p0: @once(@r(0, 6.283)); --p1: @once(@r(0, 6.283)); --p2: @once(@r(0, 6.283)); @random(${shapeFrequency}) { --X: @x; --Y: @y; --f0: $(X*0.9+Y*1.7+p0); --g0: $(X*2.1+Y*0.8+p0*1.7); --f1: $(X*1.3+Y*2.3+p1); --g1: $(X*2.7+Y*1.9+p1*1.7); --f2: $(X*0.7+Y*2.9+p2); --g2: $(X*1.9+Y*1.3+p2*1.7); --ua: $(13.65+7.8*sin(f0+-0.9)+4.55*sin(g0+-2.1)); --ub: $(13.65+7.8*sin(f0+-0.6)+4.55*sin(g0+-1.4)); --uc: $(13.65+7.8*sin(f0+-0.3)+4.55*sin(g0+-0.7)); --ud: $(13.65+7.8*sin(f0+0)+4.55*sin(g0+0)); --va: $(11.55+6.6*sin(f1+-1.3)+3.85*sin(g1+-2.7)); --vb: $(11.55+6.6*sin(f1+-0.8667)+3.85*sin(g1+-1.8)); --vc: $(11.55+6.6*sin(f1+-0.4333)+3.85*sin(g1+-0.9)); --vd: $(11.55+6.6*sin(f1+0)+3.85*sin(g1+0)); --wa: $(12.6+7.2*sin(f2+-0.7)+4.2*sin(g2+-1.9)); --wb: $(12.6+7.2*sin(f2+-0.4667)+4.2*sin(g2+-1.2667)); --wc: $(12.6+7.2*sin(f2+-0.2333)+4.2*sin(g2+-0.6333)); --wd: $(12.6+7.2*sin(f2+0)+4.2*sin(g2+0)); --ta: calc(50% - (@var(--ua) + @var(--va) + @var(--wa)) * 0.5%); --tb: calc(50% - (@var(--ub) + @var(--vb) + @var(--wb)) * 0.5%); --tc: calc(50% - (@var(--uc) + @var(--vc) + @var(--wc)) * 0.5%); --td: calc(50% - (@var(--ud) + @var(--vd) + @var(--wd)) * 0.5%); --up: 0% @var(--ta), 33.333% @var(--tb), 66.667% @var(--tc), 100% @var(--td); --dn: 100% calc(100% - @var(--td)), 66.667% calc(100% - @var(--tc)), 33.333% calc(100% - @var(--tb)), 0% calc(100% - @var(--ta)); background: @p(var(--color2)); clip-path: polygon(@var(--up), @var(--dn)); :before { content: ''; position: absolute; inset: 0; background: @p(var(--color1)); clip-path: polygon(@var(--up), 100% calc(@var(--td) + @var(--ud) * 1%), 66.667% calc(@var(--tc) + @var(--uc) * 1%), 33.333% calc(@var(--tb) + @var(--ub) * 1%), 0% calc(@var(--ta) + @var(--ua) * 1%)); -webkit-transition: ease 450ms; transition: ease 450ms; } :after { content: ''; position: absolute; inset: 0; background: @p(var(--color3)); clip-path: polygon(0% calc(100% - @var(--ta) - @var(--wa) * 1%), 33.333% calc(100% - @var(--tb) - @var(--wb) * 1%), 66.667% calc(100% - @var(--tc) - @var(--wc) * 1%), 100% calc(100% - @var(--td) - @var(--wd) * 1%), @var(--dn)); -webkit-transition: ease 450ms; transition: ease 450ms; } } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box; } :container { background: var(--color0); overflow:hidden; }"
  }
}
