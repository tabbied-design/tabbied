{
  "name": "Pentomino",
  "slug": "pentomino",
  "galleryOrder": 4038,
  "description": "All twelve pentominoes packed into a rectangle and repeated edge to edge, each piece a solid block of one ink with grout lines between pieces.",
  "tags": [
    "blocks",
    "squares",
    "mosaic",
    "grid"
  ],
  "mood": [
    "playful",
    "retro"
  ],
  "density": "dense",
  "goodFor": [
    "packaging",
    "wallpaper"
  ],
  "palette": [
    "#F0F7F4",
    "#FF9F1C",
    "#2EC4B6",
    "#E71D36",
    "#011627"
