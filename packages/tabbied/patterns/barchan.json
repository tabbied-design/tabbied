{
  "name": "Barchan",
  "slug": "barchan",
  "galleryOrder": 4084,
  "description": "Crescent dunes seen from the air, every crescent turned with its horns downwind by a smooth wind field and larger where the sand runs deep.",
  "tags": [
    "arcs",
    "curves"
  ],
  "mood": [
    "organic",
    "calm"
  ],
