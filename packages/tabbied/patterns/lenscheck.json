{
  "name": "Lens Check",
  "slug": "lenscheck",
  "galleryOrder": 4053,
  "description": "A checkerboard swelling toward the middle of the sheet as if seen through a lens, its squares shrinking toward every edge.",
  "tags": [
    "checkerboard",
    "squares",
    "grid"
  ],
  "mood": [
    "bold"
  ],
  "density": "dense",
  "goodFor": [
    "poster",
    "og-image"
  ],
  "palette": [
    "#F2EFE8",
    "#16161D",
    "#2E3170"
  ],
  "colors": {
    "min": 2,
    "max": 3,
    "default": 3
