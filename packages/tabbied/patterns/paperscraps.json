{
  "name": "Paper Scraps",
  "slug": "paperscraps",
  "galleryOrder": 4280,
  "galleryWhite": true,
  "description": "A collage of torn paper scraps laid over one another at angles, each with a ragged white torn edge, some ruled, squared or dotted like pages from a notebook.",
  "tags": [
    "squares",
    "mosaic",
    "lines",
    "dots"
  ],
  "mood": [
    "playful",
    "organic"
  ],
  "density": "dense",
  "goodFor": [
    "poster",
    "packaging",
    "card-texture"
  ],
  "palette": [
    "#2B2D42",
    "#FBF7EF",
    "#E63946",
    "#F4A261",
    "#2A9D8F",
    "#A8DADC",
    "#E9C46A"
  ],
  "colors": {
    "min": 2,
    "max": 7,
    "default": 7
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "6x9",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( @random(${shapeFrequency}) { background: var(--color1); -webkit-clip-path: polygon(@calc(8 + @ri(-5, 5))% @calc(8 + @ri(-5, 5))%, 20% @calc(8 + @ri(-3, 3))%, 32% @calc(8 + @ri(-3, 3))%, 44% @calc(8 + @ri(-3, 3))%, 56% @calc(8 + @ri(-3, 3))%, 68% @calc(8 + @ri(-3, 3))%, 80% @calc(8 + @ri(-3, 3))%, @calc(92 + @ri(-5, 5))% @calc(8 + @ri(-5, 5))%, @calc(92 + @ri(-3, 3))% 20%, @calc(92 + @ri(-3, 3))% 32%, @calc(92 + @ri(-3, 3))% 44%, @calc(92 + @ri(-3, 3))% 56%, @calc(92 + @ri(-3, 3))% 68%, @calc(92 + @ri(-3, 3))% 80%, @calc(92 + @ri(-5, 5))% @calc(92 + @ri(-5, 5))%, 80% @calc(92 + @ri(-3, 3))%, 68% @calc(92 + @ri(-3, 3))%, 56% @calc(92 + @ri(-3, 3))%, 44% @calc(92 + @ri(-3, 3))%, 32% @calc(92 + @ri(-3, 3))%, 20% @calc(92 + @ri(-3, 3))%, @calc(8 + @ri(-5, 5))% @calc(92 + @ri(-5, 5))%, @calc(8 + @ri(-3, 3))% 80%, @calc(8 + @ri(-3, 3))% 68%, @calc(8 + @ri(-3, 3))% 56%, @calc(8 + @ri(-3, 3))% 44%, @calc(8 + @ri(-3, 3))% 32%, @calc(8 + @ri(-3, 3))% 20%); clip-path: polygon(@calc(8 + @ri(-5, 5))% @calc(8 + @ri(-5, 5))%, 20% @calc(8 + @ri(-3, 3))%, 32% @calc(8 + @ri(-3, 3))%, 44% @calc(8 + @ri(-3, 3))%, 56% @calc(8 + @ri(-3, 3))%, 68% @calc(8 + @ri(-3, 3))%, 80% @calc(8 + @ri(-3, 3))%, @calc(92 + @ri(-5, 5))% @calc(8 + @ri(-5, 5))%, @calc(92 + @ri(-3, 3))% 20%, @calc(92 + @ri(-3, 3))% 32%, @calc(92 + @ri(-3, 3))% 44%, @calc(92 + @ri(-3, 3))% 56%, @calc(92 + @ri(-3, 3))% 68%, @calc(92 + @ri(-3, 3))% 80%, @calc(92 + @ri(-5, 5))% @calc(92 + @ri(-5, 5))%, 80% @calc(92 + @ri(-3, 3))%, 68% @calc(92 + @ri(-3, 3))%, 56% @calc(92 + @ri(-3, 3))%, 44% @calc(92 + @ri(-3, 3))%, 32% @calc(92 + @ri(-3, 3))%, 20% @calc(92 + @ri(-3, 3))%, @calc(8 + @ri(-5, 5))% @calc(92 + @ri(-5, 5))%, @calc(8 + @ri(-3, 3))% 80%, @calc(8 + @ri(-3, 3))% 68%, @calc(8 + @ri(-3, 3))% 56%, @calc(8 + @ri(-3, 3))% 44%, @calc(8 + @ri(-3, 3))% 32%, @calc(8 + @ri(-3, 3))% 20%); -webkit-transform: translate(@r(-14, 14)%, @r(-14, 14)%) rotate(@r(-40, 40)deg) scale(@r(1.15, 1.45)); transform: translate(@r(-14, 14)%, @r(-14, 14)%) rotate(@r(-40, 40)deg) scale(@r(1.15, 1.45)); :before { content: ''; position: absolute; inset: 11%; background: @p(var(--color2), var(--color3), var(--color4), var(--color5), var(--color6)); -webkit-transition: ease 450ms; transition: ease 450ms; } :after { content: ''; position: absolute; inset: 11%; background: @p(@var(--lines), @var(--grid), @var(--dots), none, none); opacity: 0.45; -webkit-transition: ease 450ms; transition: ease 450ms; } } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box; --lines: repeating-linear-gradient(180deg, transparent 0 11%, var(--color1) 11% 13.5%); --grid: repeating-linear-gradient(90deg, transparent 0 11%, var(--color1) 11% 13%), repeating-linear-gradient(180deg, transparent 0 11%, var(--color1) 11% 13%); --dots: radial-gradient(circle at 50% 50%, var(--color1) 0 22%, transparent 22%) 0 0 / 14% 14%; } :container { background: var(--color0); overflow:hidden; }"
  }
}
