{
  "name": "Paper Sea",
  "slug": "papersea",
  "galleryOrder": 4281,
  "description": "A sea cut from layers of paper, one wave-edged sheet per row from pale at the top to deep at the bottom, each laid over the one behind with a thin shadow along its edge.",
  "tags": [
    "waves",
    "stripes",
    "curves"
  ],
  "mood": [
    "calm",
    "organic"
  ],
  "density": "dense",
  "goodFor": [
    "hero-background",
    "wallpaper",
    "poster"
  ],
  "palette": [
    "#FDF6E9",
    "#BFE3E8",
    "#7CC3CF",
    "#3E8EA8",
    "#1F5F82",
    "#0E3352"
  ],
