{
  "name": "Paper Sea",
  "slug": "papersea",
  "galleryOrder": 4281,
  "description": "A sea cut from layers of paper, one wave-edged sheet per row from pale at the top to deep at the bottom, each laid over the one behind with a thin shadow along its edge.",
  "tags": [
    "waves",
    "stripes",
    "curves"
  ],
  "mood": [
    "calm",
    "organic"
  ],
  "density": "dense",
  "goodFor": [
    "hero-background",
    "wallpaper",
    "poster"
  ],
  "palette": [
    "#FDF6E9",
    "#BFE3E8",
    "#7CC3CF",
    "#3E8EA8",
    "#1F5F82",
    "#0E3352"
  ],
  "colors": {
    "min": 2,
    "max": 6,
    "default": 6
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "6x9",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( --ph: @pd(@p(0, 0.8, 1.6, 2.4, 3.2, 4, 4.8, 5.6)); --pk: @pd(@p(0, 0.8, 1.6, 2.4, 3.2, 4, 4.8, 5.6)); @random(${shapeFrequency}) { --a: @calc(1.365913 * (@x - 1) + 1.9 * @y + $(ph)); --b: @calc(2.856 * (@x - 1) - 1.3 * @y + $(pk)); --t: @calc(1 + floor(min(0.999, (@y - 1) / @Y) * 5)); --w: @match($(t) == 1, var(--color1), $(t) == 2, var(--color2), $(t) == 3, var(--color3), $(t) == 4, var(--color4), var(--color5)); --e: polygon(0% $(round(2100+1300*sin(-1.3659+a)+500*sin(-2.856+b))/100)%, 8.33% $(round(2100+1300*sin(-1.1383+a)+500*sin(-2.38+b))/100)%, 16.67% $(round(2100+1300*sin(-0.9106+a)+500*sin(-1.904+b))/100)%, 25% $(round(2100+1300*sin(-0.683+a)+500*sin(-1.428+b))/100)%, 33.33% $(round(2100+1300*sin(-0.4553+a)+500*sin(-0.952+b))/100)%, 41.67% $(round(2100+1300*sin(-0.2277+a)+500*sin(-0.476+b))/100)%, 50% $(round(2100+1300*sin(0+a)+500*sin(0+b))/100)%, 58.33% $(round(2100+1300*sin(0.2277+a)+500*sin(0.476+b))/100)%, 66.67% $(round(2100+1300*sin(0.4553+a)+500*sin(0.952+b))/100)%, 75% $(round(2100+1300*sin(0.683+a)+500*sin(1.428+b))/100)%, 83.33% $(round(2100+1300*sin(0.9106+a)+500*sin(1.904+b))/100)%, 91.67% $(round(2100+1300*sin(1.1383+a)+500*sin(2.38+b))/100)%, 100% $(round(2100+1300*sin(1.3659+a)+500*sin(2.856+b))/100)%, 100% 100%, 0% 100%); :before { content: ''; position: absolute; left: -100%; width: 200%; top: -5%; height: 200%; background: var(--color5); opacity: 0.3; -webkit-clip-path: @var(--e); clip-path: @var(--e); -webkit-transition: ease 450ms; transition: ease 450ms; } :after { content: ''; position: absolute; left: -100%; width: 200%; top: 0%; height: 200%; background: @p(@var(--w)); -webkit-clip-path: @var(--e); clip-path: @var(--e); -webkit-transition: ease 450ms; transition: ease 450ms; } } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box; } :container { background: var(--color0); overflow:hidden; }"
  }
}
