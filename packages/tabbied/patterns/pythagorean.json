{
  "name": "Pythagorean",
  "slug": "pythagorean",
  "galleryOrder": 4236,
  "description": "The Pythagorean tiling: big and small squares, both turned off the grid, locking together so every small square sits in the notch between four big ones.",
  "tags": [
    "squares",
    "mosaic",
    "grid"
  ],
  "mood": [
    "calm",
    "elegant"
  ],
  "density": "dense",
  "goodFor": [
    "wallpaper",
    "textile"
  ],
  "palette": [
    "#EFE7DA",
    "#5B3A29",
    "#A0522D",
    "#D9A066",
    "#6B7F3A",
    "#2F4858"
  ],
  "colors": {
    "min": 2,
    "max": 6,
    "default": 6
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "6x9",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
