-webkit-clip-path: @match(y % 2 == 1, polygon(100% 100%, 0% 100%, @calc(round((50 + 100 * $(pa)) * 100) / 100)% @calc(round((66.67 + 100 * $(pb)) * 100) / 100)%, 100% 100%, 50% 0%, 0% 100%, 0% @calc(round((33.33 + 100 * $(pl)) * 100) / 100)%, 50% 0%), polygon(100% 0%, 50% 100%, @calc(round((50 + 100 * $(pa)) * 100) / 100)% @calc(round((33.33 + 100 * $(pb)) * 100) / 100)%, 100% 0%, 50% 100%, 0% 100%, 0% @calc(round((66.67 + 100 * $(pl)) * 100) / 100)%, 50% 100%, 100% 100%, 50% 100%, 100% @calc(round((66.67 + 100 * $(pr)) * 100) / 100)%, 100% 100%, 50% 100%)); clip-path: @match(y % 2 == 1, polygon(100% 100%, 0% 100%, @calc(round((50 + 100 * $(pa)) * 100) / 100)% @calc(round((66.67 + 100 * $(pb)) * 100) / 100)%, 100% 100%, 50% 0%, 0% 100%, 0% @calc(round((33.33 + 100 * $(pl)) * 100) / 100)%, 50% 0%), polygon(100% 0%, 50% 100%, @calc(round((50 + 100 * $(pa)) * 100) / 100)% @calc(round((33.33 + 100 * $(pb)) * 100) / 100)%, 100% 0%, 50% 100%, 0% 100%, 0% @calc(round((66.67 + 100 * $(pl)) * 100) / 100)%, 50% 100%, 100% 100%, 50% 100%, 100% @calc(round((66.67 + 100 * $(pr)) * 100) / 100)%, 100% 100%, 50% 100%)); -webkit-transition: ease 450ms; transition: ease 450ms; } } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box; } :container { background: var(--color0); overflow:hidden; }"
  }
