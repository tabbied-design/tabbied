{
  "name": "Pyramid Relief",
  "slug": "pyramidrelief",
  "galleryOrder": 4036,
  "galleryWhite": true,
  "description": "A triangular grid raised into low pyramids lit from the upper left, each face in one of three tones and every peak nudged a little off center, like chip-carved wood.",
  "tags": [
    "triangles",
    "grid",
    "mosaic"
  ],
  "mood": [
    "elegant",
    "organic"
  ],
  "density": "dense",
  "goodFor": [
    "textile",
    "wallpaper"
  ],
  "palette": [
    "#3A2E26",
    "#EBD9BC",
    "#C49A6C",
    "#7A5235"
  ],
  "colors": {
    "min": 2,
    "max": 4,
    "default": 4
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "8x12",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
