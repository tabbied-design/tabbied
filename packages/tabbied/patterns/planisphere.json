{
  "name": "Planisphere",
  "slug": "planisphere",
  "galleryOrder": 4178,
  "description": "A pale star chart: hour lines fan out from a pole near one corner, declination circles ring it, the ecliptic sweeps through in red and stars of every magnitude dot the sheet.",
  "tags": [
    "lines",
    "concentric",
    "radial",
    "dots"
  ],
  "mood": [
    "technical",
    "elegant"
  ],
  "density": "sparse",
  "goodFor": [
    "hero-background",
    "card-texture",
    "wallpaper"
  ],
  "palette": [
    "#F3EDDE",
    "#1C2C4C",
    "#B5402F",
    "#C8922E",
    "#8E9AB3"
  ],
  "colors": {
    "min": 2,
    "max": 5,
    "default": 5
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "8x12",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 0.8,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
