{
  "name": "Windmill",
  "slug": "windmill",
  "galleryOrder": 4237,
  "description": "Windmill tiling: every small square ringed by four dominoes turning like the sails of a windmill, the pinwheels interlocking edge to edge in three inks.",
  "tags": [
    "squares",
    "blocks",
    "grid",
    "mosaic"
  ],
  "mood": [
    "calm",
    "retro"
  ],
  "density": "dense",
  "goodFor": [
    "wallpaper",
    "textile"
  ],
  "palette": [
    "#F7F4EF",
    "#4F6D7A",
    "#C0D6DF",
    "#DD6E42",
    "#E8DAB2"
  ],
  "colors": {
    "min": 2,
    "max": 5,
    "default": 5
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "10x15",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( --wo: @pd(@ri(0, 4)); --wc: @pd(@ri(0, 2)); --wk: @calc(0 + (@x + 3 * @y + $(wo)) % 5); --wt: @calc(0 + (min(1, $(wk)) + (floor($(wk) / 2) % 2) * (1 - floor($(wk) / 4)) + $(wc)) % 3); @random(${shapeFrequency}) { :before { content: ''; position: absolute; top: @match($(wk) == 0, 5%, $(wk) == 1, 5%, $(wk) == 2, 5%, $(wk) == 3, 5%, $(wk) == 4, 0%, 0%); right: @match($(wk) == 0, 5%, $(wk) == 1, 5%, $(wk) == 2, 0%, $(wk) == 3, 5%, $(wk) == 4, 5%, 0%); bottom: @match($(wk) == 0, 5%, $(wk) == 1, 0%, $(wk) == 2, 5%, $(wk) == 3, 5%, $(wk) == 4, 5%, 0%); left: @match($(wk) == 0, 5%, $(wk) == 1, 5%, $(wk) == 2, 5%, $(wk) == 3, 0%, $(wk) == 4, 5%, 0%); border-radius: @match($(wk) == 0, 16%, $(wk) == 1, 16%, $(wk) == 2, 16%, $(wk) == 3, 0%, $(wk) == 4, 0%, 0%) @match($(wk) == 0, 16%, $(wk) == 1, 16%, $(wk) == 2, 0%, $(wk) == 3, 16%, $(wk) == 4, 0%, 0%) @match($(wk) == 0, 16%, $(wk) == 1, 0%, $(wk) == 2, 0%, $(wk) == 3, 16%, $(wk) == 4, 16%, 0%) @match($(wk) == 0, 16%, $(wk) == 1, 0%, $(wk) == 2, 16%, $(wk) == 3, 0%, $(wk) == 4, 16%, 0%); background: @match($(wt) == 0, @p(var(--color1)), $(wt) == 1, @p(var(--color2)), @p(var(--color3))); -webkit-transition: ease 450ms; transition: ease 450ms; } } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box; } :container { background: var(--color0); overflow:hidden; }"
  }
}
