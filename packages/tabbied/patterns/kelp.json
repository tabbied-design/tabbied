{
  "name": "Kelp",
  "slug": "kelp",
  "galleryOrder": 4122,
  "galleryWhite": true,
  "description": "A kelp forest: long ribbon blades waving up the sheet side by side, with a gas float here and there along their edges.",
  "tags": [
    "waves",
    "stripes",
    "curves",
    "dots"
  ],
  "mood": [
    "organic",
    "calm"
  ],
  "density": "medium",
  "goodFor": [
    "wallpaper",
    "hero-background",
    "textile"
  ],
  "palette": [
    "#0E2A33",
    "#E0B860",
    "#8C7A2E",
    "#5E7D3A",
    "#A3A84B",
    "#3F6B4A",
    "#F0D9A0"
  ],
  "colors": {
    "min": 2,
    "max": 7,
    "default": 7
  },
  "options": [
    {
      "id": "grid",
      "displayName": "Columns and rows",
      "type": "ButtonSelectGroup",
      "default": "6x9",
      "options": [
        "2x3",
        "4x6",
        "6x9",
        "8x12",
        "10x15"
      ],
      "replace": "${grid}"
    },
    {
      "id": "frequency",
      "displayName": "Frequency",
      "type": "Slider",
      "default": 1,
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "replace": "${shapeFrequency}"
    }
  ],
  "code": {
    "style": "--rule: ( @random(${shapeFrequency}) { :before { content: ''; position: absolute; inset: 0; background: @match(@x % 4 == 1, var(--color2), @match(@x % 4 == 2, var(--color4), @match(@x % 4 == 3, var(--color3), var(--color5)))); -webkit-clip-path: polygon(@calc(50 + 14 * sin((@y - 1) * 0.8 + @x * 2.1) - 20 - 6 * sin((@y - 1) * 0.55 + @x * 1.3))% 0%, @calc(50 + 14 * sin((@y - 1) * 0.8 + @x * 2.1) + 20 + 6 * sin((@y - 1) * 0.55 + @x * 1.3))% 0%, @calc(50 + 14 * sin((@y - 0.5) * 0.8 + @x * 2.1) + 20 + 6 * sin((@y - 0.5) * 0.55 + @x * 1.3))% 50%, @calc(50 + 14 * sin((@y) * 0.8 + @x * 2.1) + 20 + 6 * sin((@y) * 0.55 + @x * 1.3))% 100%, @calc(50 + 14 * sin((@y) * 0.8 + @x * 2.1) - 20 - 6 * sin((@y) * 0.55 + @x * 1.3))% 100%, @calc(50 + 14 * sin((@y - 0.5) * 0.8 + @x * 2.1) - 20 - 6 * sin((@y - 0.5) * 0.55 + @x * 1.3))% 50%); clip-path: polygon(@calc(50 + 14 * sin((@y - 1) * 0.8 + @x * 2.1) - 20 - 6 * sin((@y - 1) * 0.55 + @x * 1.3))% 0%, @calc(50 + 14 * sin((@y - 1) * 0.8 + @x * 2.1) + 20 + 6 * sin((@y - 1) * 0.55 + @x * 1.3))% 0%, @calc(50 + 14 * sin((@y - 0.5) * 0.8 + @x * 2.1) + 20 + 6 * sin((@y - 0.5) * 0.55 + @x * 1.3))% 50%, @calc(50 + 14 * sin((@y) * 0.8 + @x * 2.1) + 20 + 6 * sin((@y) * 0.55 + @x * 1.3))% 100%, @calc(50 + 14 * sin((@y) * 0.8 + @x * 2.1) - 20 - 6 * sin((@y) * 0.55 + @x * 1.3))% 100%, @calc(50 + 14 * sin((@y - 0.5) * 0.8 + @x * 2.1) - 20 - 6 * sin((@y - 0.5) * 0.55 + @x * 1.3))% 50%); -webkit-transition: ease 450ms; transition: ease 450ms; } :after { content: ''; position: absolute; left: @calc(50 + 14 * sin((@y - 0.5) * 0.8 + @x * 2.1) + 20 + 6 * sin((@y - 0.5) * 0.55 + @x * 1.3) - 4)%; top: 36%; width: 16%; height: 22%; border-radius: 50%; background: @p(var(--color1), var(--color6)); opacity: @p(0, 0, 1); -webkit-transform: rotate(@r(-30, 30)deg); transform: rotate(@r(-30, 30)deg); -webkit-transition: ease 450ms; transition: ease 450ms; } } -webkit-transition: ease 450ms; transition: ease 450ms; );",
    "doodle": ":doodle { @grid: ${grid}; @size: ${width} ${height}; overflow:hidden; text-align:center; box-sizing:border-box; } :container { background: var(--color0); overflow:hidden; }"
  }
}
