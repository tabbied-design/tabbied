{
  "name": "remotion-explainers",
  "version": "1.0.0",
  "private": true,
  "description": "Explainer films drawn with Tabbied patterns and rendered with Remotion: Grace Hopper, and the economics of credit cards.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "render:grace-hopper": "remotion render GraceHopper out/grace-hopper.mp4",
    "render:credit-cards": "remotion render CreditCards out/credit-cards.mp4",
    "still": "remotion still",
    "images": "node scripts/generate-images.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "audio": "tsx scripts/audio.ts",
    "audio:stub": "tsx scripts/elevenlabs-stub.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.531",
    "@remotion/fonts": "4.0.531",
    "@remotion/transitions": "4.0.531",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.531",
    "tabbied": "^0.7.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
